DB_URL=jdbc:postgresql://localhost:5432/deary
DB_USERNAME=deary
DB_PASSWORD=deary
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
APPLE_CLIENT_IDS=com.example.deary
# Sign in with Apple 연결 해지(탈퇴). 비우면 해지를 건너뛴다. APPLE_PRIVATE_KEY는 .p8 내용(줄바꿈은 \n 가능)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_CLIENT_IDS=000000000000-example.apps.googleusercontent.com
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROFILE_BUCKET=avatars
SUPABASE_DIARY_BUCKET=diary-images
# 신고 접수 알림을 받을 디스코드·슬랙 웹훅 URL. 비워 두면 알림을 보내지 않는다
REPORT_WEBHOOK_URL=
# Sentry 오류 전송(prod 전용). 로컬은 application-local.yml에서 항상 비활성. 성능 추적 샘플링은 0~1, 기본 0
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
